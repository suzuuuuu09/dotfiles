{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"dependencyDashboard": false,
	"nix": {
		"enabled": true
	},
	"github-actions": {
		"enabled": true
	},
	"automerge": false,
	"rebaseWhen": "behind-base-branch",
	"labels": ["dependencies"],
	"addLabels": ["renovate", "automerge"],
	"timezone": "Asia/Tokyo",
	"lockFileMaintenance": {
		"enabled": true,
		"recreateWhen": "always",
		"schedule": ["at any time"]
	},
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security"],
		"schedule": ["at any time"]
	},
	"customManagers": [
		{
			"customType": "jsonata",
			"fileFormat": "json",
			"managerFilePatterns": [
				"/^skills/registry/sources\\.lock\\.json$/"
			],
			"matchStrings": [
				"($root := $; $each(npins.pins, function($pin, $name) { $lookup($root.manifests, $name).pin.at = null ? {\"depName\": $name, \"packageName\": ($pin.repository.type = \"GitHub\" ? \"https://github.com/\" & $pin.repository.owner & \"/\" & $pin.repository.repo : $pin.repository.url), \"currentValue\": $pin.branch, \"currentDigest\": $pin.revision, \"datasource\": \"git-refs\"} : undefined }))"
			]
		},
		{
			"customType": "jsonata",
			"fileFormat": "json",
			"managerFilePatterns": [
				"/^omp/plugins/npins/sources\\.json$/"
			],
			"matchStrings": [
				"$each(pins, function($pin, $name) { $pin.frozen ? undefined : {\"depName\": $name, \"packageName\": ($pin.repository.type = \"GitHub\" ? \"https://github.com/\" & $pin.repository.owner & \"/\" & $pin.repository.repo : $pin.repository.url), \"currentValue\": $pin.branch, \"currentDigest\": $pin.revision, \"datasource\": \"git-refs\"} })"
			]
		}
	],
	"packageRules": [
		{
			"matchManagers": ["custom.jsonata"],
			"matchFileNames": ["skills/registry/sources.lock.json", "omp/plugins/npins/sources.json"],
			"groupName": "agent sources",
			"commitMessagePrefix": "📦 deps(agents): ",
			"postUpgradeTasks": {
				"commands": ["bash scripts/renovate-agent-sources.sh"],
				"fileFilters": ["skills/registry/sources.lock.json", "omp/plugins/npins/sources.json"],
				"executionMode": "branch"
			}
		},

		// flake inputsがコミットハッシュで固定されているものは更新しない
		{
			"matchManagers": ["nix"],
			"matchJsonata": ["$exists(currentDigest)"],
			"enabled": false
		},
		{
			"matchManagers": ["nix"],
			"groupName": "nix flake inputs",
			"commitMessagePrefix": "📦 deps(flake): "
		},
		{
			"matchManagers": ["github-actions"],
			"commitMessagePrefix": "📦 deps(actions): "
		}
	]
}
