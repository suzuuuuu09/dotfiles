#!/bin/sh

set -eu

config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_file="$config_dir/cargo-commitlint/commitlint.toml"

if [ "$#" -lt 1 ]; then
  echo "cargo-commitlint: commit message file is missing" >&2
  exit 2
fi

header=$(sed -n '1p' "$1")
case "$header" in
  Merge\ *|Revert\ *|WIP*|wip*|fixup!*|squash!*|"Initial commit"|"initial commit")
    ;;
  "✨ feat"*|"🐛 fix"*|"📝 docs"*|"💄 style"*|"♻️ refactor"*|"✅ test"*|"🔧 chore"*|"⚡️ perf"*|"⏪️ revert"*|"📦 deps"*|feat*|fix*|update*|docs*|style*|refactor*|perf*|test*|build*|ci*|chore*|revert*|deps*)
    ;;
  *)
    echo "cargo-commitlint: gitmoji does not match commit type" >&2
    exit 1
    ;;
esac

if ! command -v cargo-commitlint >/dev/null 2>&1; then
  echo "cargo-commitlint: executable not found; refusing the commit" >&2
  exit 127
fi

if [ ! -r "$config_file" ]; then
  echo "cargo-commitlint: config not found: $config_file" >&2
  exit 78
fi

exec cargo-commitlint \
  --config "$config_file" \
  check \
  --edit "$1"
